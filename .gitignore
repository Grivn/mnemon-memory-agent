# Dependencies and build output
node_modules/
/lib/
plugins/*/lib/
*.tsbuildinfo
coverage/
.cache/

# Credentials: keep API keys in the environment or a local .env, never in the repository
.env
.env.*
!.env.example

# Expanded run records (tools/restore_runs.py) and local experiment output
/runs-expanded/
/out/

# HaluMem's run records are never committed: its license (CC BY-NC-ND 4.0) allows no adapted material to be shared
# (DATA-LICENSES.md)
/runs/**/*[Hh]alu[Mm]em*

# Local deny list of tools/audit.py: words and hosts that must never be committed, kept out of the repository itself
/.audit-deny

# Paper build intermediates (main.pdf itself is kept)
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.bbl
docs/paper/*.blg
